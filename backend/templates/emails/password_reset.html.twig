{% extends 'emails/layout.html.twig' %}

{# "¿Olvidaste tu contraseña?": the link to choose a new one. #}
{% block content %}
<p>Hola, {{ fullName }}:</p>

<p>Pediste cambiar tu contraseña. Elige una nueva con este enlace:</p>

<p>
    <a href="{{ resetUrl }}" style="display:inline-block;padding:12px 20px;background:#1e3a5f;color:#ffffff;text-decoration:none;border-radius:6px;">Elegir una contraseña nueva</a>
</p>

<p style="color:#5b6576;font-size:13px;">El enlace funciona una sola vez durante una hora. Si no lo pediste, ignora este correo: tu contraseña sigue igual.</p>
{% endblock %}
