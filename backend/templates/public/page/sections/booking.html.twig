{# Booking a free plan's session: the free slots of the coming days (the first day open), and who is booking. A plain
   HTML form, like the lead form: `website` is the bots' trap, `_t` when the form was drawn. #}
{% set booking = bookings[section.id] %}
<section id="reserva">
    <div class="wrap form-box">
        {% if fields.heading %}<{{ first ? 'h1' : 'h2' }}>{{ fields.heading }}</{{ first ? 'h1' : 'h2' }}>{% endif %}
        {% if booked %}
            <p class="notice" role="status">{{ fields.successMessage }}</p>
        {% elseif booking.days is empty %}
            <p class="notice">En este momento no hay horarios disponibles. Escríbenos con el formulario y te contactamos.</p>
        {% else %}
            {% if fields.body %}<p>{{ fields.body }}</p>{% endif %}
            {% if bookingErrors['_form'] is defined %}<p class="notice notice-error" role="alert">{{ bookingErrors['_form'] }}</p>{% endif %}
            <form method="post" action="{{ preview ? '#reserva' : bookingAction }}" novalidate{% if preview %} onsubmit="return false"{% endif %}>
                <fieldset class="slots">
                    <legend>Elige el día y la hora ({{ booking.plan.durationMinutes }} minutos)</legend>
                    {% for day in booking.days %}
                        <details{{ loop.first ? ' open' }}>
                            <summary>{{ day.label|capitalize }}</summary>
                            <div class="slot-list">
                                {% for slot in day.slots %}
                                    <label class="slot"><input type="radio" name="slot" value="{{ slot.value }}"{{ (bookingValues.slot ?? '') == slot.value ? ' checked' }}> <span>{{ slot.label }}</span></label>
                                {% endfor %}
                            </div>
                        </details>
                    {% endfor %}
                    {% if bookingErrors.slot is defined %}<p class="error">{{ bookingErrors.slot }}</p>{% endif %}
                </fieldset>
                <div class="field">
                    <label for="b-name">Nombre completo</label>
                    <input type="text" id="b-name" name="name" autocomplete="name" maxlength="180" value="{{ bookingValues.name ?? '' }}">
                    {% if bookingErrors.name is defined %}<p class="error">{{ bookingErrors.name }}</p>{% endif %}
                </div>
                <div class="field">
                    <label for="b-email">Correo electrónico</label>
                    <input type="email" id="b-email" name="email" autocomplete="email" maxlength="180" value="{{ bookingValues.email ?? '' }}">
                    {% if bookingErrors.email is defined %}<p class="error">{{ bookingErrors.email }}</p>{% endif %}
                </div>
                <div class="field">
                    <label for="b-phone">Teléfono (opcional)</label>
                    <input type="tel" id="b-phone" name="phone" autocomplete="tel" maxlength="40" value="{{ bookingValues.phone ?? '' }}">
                    {% if bookingErrors.phone is defined %}<p class="error">{{ bookingErrors.phone }}</p>{% endif %}
                </div>
                <div class="field">
                    <label class="check"><input type="checkbox" name="consent" value="1"{{ (bookingValues.consent ?? '') ? ' checked' }}> <span>Autorizo el tratamiento de mis datos según la <a href="{{ privacyUrl }}" target="_blank" rel="noopener">política de privacidad</a>.</span></label>
                    {% if bookingErrors.consent is defined %}<p class="error">{{ bookingErrors.consent }}</p>{% endif %}
                </div>
                <div class="hp" aria-hidden="true">
                    <label for="b-website">No llenes este campo</label>
                    <input type="text" id="b-website" name="website" tabindex="-1" autocomplete="off">
                </div>
                <input type="hidden" name="section" value="{{ section.id }}">
                <input type="hidden" name="_t" value="{{ timeToken }}">
                <button class="btn" type="submit">{{ fields.submitLabel }}</button>
            </form>
        {% endif %}
    </div>
</section>
