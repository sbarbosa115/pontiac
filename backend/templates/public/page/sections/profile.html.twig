{% import 'public/page/_icons.html.twig' as ui %}
{% set tag = first ? 'h1' : 'h2' %}
<section id="{{ section.id }}" class="{{ alt ? 'alt' }}{{ reveal ? ' reveal' }}">
    <div class="wrap profile{{ fields.image ? ' has-image' }}">
        {% if fields.image %}<div class="profile-media">{{ include('public/page/_image.html.twig', {id: fields.image, sizes: '(max-width: 880px) 100vw, 360px', eager: first}) }}</div>{% endif %}
        <div>
            <{{ tag }}>{{ fields.heading }}</{{ tag }}>
            {% for paragraph in fields.body|split("\n\n") %}{% if paragraph %}<p>{{ paragraph|nl2br }}</p>{% endif %}{% endfor %}
            {% if fields.credentials is not empty %}
                <ul class="chips">
                    {% for item in fields.credentials %}<li>{{ ui.tick() }}{{ item.title }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</section>
