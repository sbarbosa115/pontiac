<section id="{{ section.id }}">
    <div class="wrap">
        {% if fields.heading %}<{{ first ? 'h1' : 'h2' }}>{{ fields.heading }}</{{ first ? 'h1' : 'h2' }}>{% endif %}
        <div class="grid">
            {% for item in fields.items %}
                <div class="card">
                    <h3>{{ item.title }}</h3>
                    {% if item.body %}<p>{{ item.body }}</p>{% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
