{% import 'public/page/_icons.html.twig' as ui %}
{% set tag = first ? 'h1' : 'h2' %}
<section id="{{ section.id }}" class="{{ alt ? 'alt' }}{{ reveal ? ' reveal' }}">
    <div class="wrap">
        {% if fields.heading %}<div class="section-head"><{{ tag }}>{{ fields.heading }}</{{ tag }}></div>{% endif %}
        <div class="grid">
            {% for item in fields.items %}
                <div class="card">
                    <div class="card-icon">{{ ui.icon('check') }}</div>
                    <h3>{{ item.title }}</h3>
                    {% if item.body %}<p>{{ item.body }}</p>{% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
