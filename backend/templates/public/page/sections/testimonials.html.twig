{% set tag = first ? 'h1' : 'h2' %}
<section id="{{ section.id }}" class="{{ alt ? 'alt' }}{{ reveal ? ' reveal' }}">
    <div class="wrap">
        {% if fields.heading %}<div class="section-head"><{{ tag }}>{{ fields.heading }}</{{ tag }}></div>{% endif %}
        <div class="grid">
            {% for item in fields.items %}
                <blockquote class="card quote">
                    <p>{{ item.quote }}</p>
                    <footer>
                        <span class="avatar" aria-hidden="true">{{ item.author|first|upper }}</span>
                        <span><strong>{{ item.author }}</strong>{% if item.role %}{{ item.role }}{% endif %}</span>
                    </footer>
                </blockquote>
            {% endfor %}
        </div>
    </div>
</section>
