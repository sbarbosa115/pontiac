{# The page's form: name, email, phone, the page's extra fields, consent. A plain HTML form that works without
   JavaScript. `website` is a trap left empty by people and filled by bots; `_t` says when the form was drawn. #}
<section id="formulario">
    <div class="wrap form-box">
        {% if fields.heading %}<{{ first ? 'h1' : 'h2' }}>{{ fields.heading }}</{{ first ? 'h1' : 'h2' }}>{% endif %}
        {% if sent %}
            <p class="notice" role="status">{{ fields.successMessage }}</p>
        {% else %}
            {% if fields.body %}<p>{{ fields.body }}</p>{% endif %}
            {% if errors['_form'] is defined %}<p class="notice notice-error" role="alert">{{ errors['_form'] }}</p>{% endif %}
            <form method="post" action="{{ preview ? '#formulario' : action }}" novalidate{% if preview %} onsubmit="return false"{% endif %}>
                <div class="field">
                    <label for="f-name">Nombre completo</label>
                    <input type="text" id="f-name" name="name" autocomplete="name" required maxlength="180" value="{{ values.name ?? '' }}">
                    {% if errors.name is defined %}<p class="error">{{ errors.name }}</p>{% endif %}
                </div>
                <div class="field">
                    <label for="f-email">Correo electrónico</label>
                    <input type="email" id="f-email" name="email" autocomplete="email" required maxlength="180" value="{{ values.email ?? '' }}">
                    {% if errors.email is defined %}<p class="error">{{ errors.email }}</p>{% endif %}
                </div>
                <div class="field">
                    <label for="f-phone">Teléfono (opcional)</label>
                    <input type="tel" id="f-phone" name="phone" autocomplete="tel" maxlength="40" value="{{ values.phone ?? '' }}">
                    {% if errors.phone is defined %}<p class="error">{{ errors.phone }}</p>{% endif %}
                </div>
                {% for field in content.form.fields %}
                    {% set id = 'f-' ~ field.key %}
                    <div class="field">
                        {% if field.type == 'checkbox' %}
                            <label class="check"><input type="checkbox" id="{{ id }}" name="{{ field.key }}" value="1"{{ (values[field.key] ?? '') ? ' checked' }}> <span>{{ field.label }}{{ not field.required ? ' (opcional)' }}</span></label>
                        {% else %}
                            <label for="{{ id }}">{{ field.label }}{{ not field.required ? ' (opcional)' }}</label>
                            {% if field.type == 'textarea' %}
                                <textarea id="{{ id }}" name="{{ field.key }}" maxlength="2000">{{ values[field.key] ?? '' }}</textarea>
                            {% elseif field.type == 'select' %}
                                <select id="{{ id }}" name="{{ field.key }}">
                                    <option value="">Elige una opción</option>
                                    {% for option in field.options %}<option value="{{ option }}"{{ (values[field.key] ?? '') == option ? ' selected' }}>{{ option }}</option>{% endfor %}
                                </select>
                            {% else %}
                                <input type="{{ field.type == 'number' ? 'number' : 'text' }}" id="{{ id }}" name="{{ field.key }}" maxlength="500" value="{{ values[field.key] ?? '' }}">
                            {% endif %}
                        {% endif %}
                        {% if errors[field.key] is defined %}<p class="error">{{ errors[field.key] }}</p>{% endif %}
                    </div>
                {% endfor %}
                <div class="field">
                    <label class="check"><input type="checkbox" name="consent" value="1"{{ (values.consent ?? '') ? ' checked' }}> <span>Autorizo el tratamiento de mis datos según la <a href="{{ privacyUrl }}" target="_blank" rel="noopener">política de privacidad</a>.</span></label>
                    {% if errors.consent is defined %}<p class="error">{{ errors.consent }}</p>{% endif %}
                </div>
                <div class="hp" aria-hidden="true">
                    <label for="f-website">No llenes este campo</label>
                    <input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off">
                </div>
                <input type="hidden" name="_t" value="{{ timeToken }}">
                <button class="btn" type="submit">{{ fields.submitLabel }}</button>
            </form>
        {% endif %}
    </div>
</section>
