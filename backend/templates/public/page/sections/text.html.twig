{% set tag = first ? 'h1' : 'h2' %}
<section id="{{ section.id }}" class="{{ alt ? 'alt' }}{{ reveal ? ' reveal' }}">
    <div class="wrap narrow prose">
        {% if fields.heading %}<{{ tag }}>{{ fields.heading }}</{{ tag }}>{% endif %}
        {% for paragraph in fields.body|split("\n\n") %}<p>{{ paragraph|nl2br }}</p>{% endfor %}
    </div>
</section>
