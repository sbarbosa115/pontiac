<section id="{{ section.id }}">
    <div class="wrap">
        {% if fields.heading %}<{{ first ? 'h1' : 'h2' }}>{{ fields.heading }}</{{ first ? 'h1' : 'h2' }}>{% endif %}
        <dl class="event">
            {% if eventDates[section.id] is defined %}<dt>Fecha</dt><dd>{{ eventDates[section.id] }}</dd>{% endif %}
            {% if fields.time %}<dt>Hora</dt><dd>{{ fields.time }}</dd>{% endif %}
            {% if fields.place %}<dt>Lugar</dt><dd>{{ fields.place }}</dd>{% endif %}
            {% if fields.seats %}<dt>Cupos</dt><dd>{{ fields.seats }}</dd>{% endif %}
        </dl>
    </div>
</section>
