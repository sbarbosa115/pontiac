{# A landing page. Server-rendered, CSS inline, no framework JavaScript: fast on a phone and read as-is by search
   engines. Always light: visitors never chose a theme. `preview` is the editor's live preview: never indexed, its
   form does not submit. #}
<!DOCTYPE html>
<html lang="{{ account.locale|replace({'_': '-'}) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ content.seo.title }}</title>
    {% if content.seo.description %}<meta name="description" content="{{ content.seo.description }}">{% endif %}
    {% if preview or not content.seo.index %}<meta name="robots" content="noindex">{% endif %}
    <link rel="canonical" href="{{ url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ content.seo.title }}">
    {% if content.seo.description %}<meta property="og:description" content="{{ content.seo.description }}">{% endif %}
    <meta property="og:url" content="{{ url }}">
    <meta property="og:site_name" content="{{ account.name }}">
    <meta property="og:locale" content="{{ account.locale }}">
    {% if socialImage %}<meta property="og:image" content="{{ socialImage }}">{% endif %}
    <meta name="twitter:card" content="{{ socialImage ? 'summary_large_image' : 'summary' }}">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script type="application/ld+json">{{ jsonLd|raw }}</script>
    <link rel="preload" href="/fonts/plus-jakarta-sans.woff2" as="font" type="font/woff2" crossorigin>
    <script>document.documentElement.classList.add('js')</script>
    <style>
        {{ include('public/page/_styles.css.twig') }}
    </style>
</head>
<body>
    {% if preview %}<div class="preview-note">Vista previa: así se verá la página al publicarla.</div>{% endif %}
    <header class="bar" data-bar>
        <div class="wrap">
            <a class="brand" href="/{{ account.slug }}"><span class="brand-mark" aria-hidden="true">{{ account.name|first|upper }}</span>{{ account.name }}</a>
            {% if cta %}<a class="btn btn-sm" href="#{{ cta.target }}">{{ cta.label }}</a>{% endif %}
        </div>
    </header>
    <main>
        {# Every section in the order the consultant put them. `alt` tints every other plain section, counted among
           the plain ones, so the stripes stay even whatever moves. #}
        {% set plain = 0 %}
        {% for section in sections %}
            {% set isPlain = section.type not in ['hero', 'cta', 'form', 'booking', 'payment'] %}
            {% if isPlain %}{% set plain = plain + 1 %}{% endif %}
            {{ include('public/page/sections/' ~ section.type ~ '.html.twig', {section: section, fields: section.fields, first: loop.first, alt: isPlain and plain is even, reveal: not loop.first}) }}
        {% endfor %}
    </main>
    <footer class="site">
        <div class="wrap">
            <p>© {{ 'now'|date('Y') }} {{ account.name }}</p>
            <p><a href="{{ privacyUrl }}">Política de privacidad</a></p>
        </div>
    </footer>
    {% if cta %}
        <div class="sticky-cta" data-sticky aria-hidden="true">
            <a class="btn btn-block" href="#{{ cta.target }}" tabindex="-1">{{ cta.label }} <span class="arrow">→</span></a>
        </div>
    {% endif %}
    {{ include('public/page/_script.html.twig') }}
</body>
</html>
