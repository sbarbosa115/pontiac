{# Every public page: light only (visitors never chose a theme), server-rendered, no framework JavaScript. #}
<!DOCTYPE html>
<html lang="es-CO">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Pontiac{% endblock %}</title>
        {% block meta %}{% endblock %}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <style>
            :root { --ink: #1b2330; --muted: #5b6576; --bg: #f6f7f9; --primary: #1e3a5f; --accent: #1f7a55; }
            * { box-sizing: border-box; }
            body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.6; }
            main { max-width: 720px; margin: 0 auto; padding: 72px 16px; }
            h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.2; margin: 0 0 16px; color: var(--primary); }
            p { font-size: 1.1rem; color: var(--muted); margin: 0 0 16px; }
            .btn { display: inline-block; background: var(--primary); color: #fff; padding: 12px 22px; border-radius: 8px; border: 0; font: inherit; font-weight: 600; cursor: pointer; }
            .btn-danger { background: #b3261e; }
            .notice { padding: 14px; border-radius: 8px; background: #e6edf5; border-left: 4px solid var(--primary); color: var(--ink); }
            .notice-error { background: #fbe9e7; border-left-color: #b3261e; }
            dl.summary { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; font-size: 1.05rem; }
            dl.summary dt { font-weight: 600; }
            dl.summary dd { margin: 0; }
            details { border-bottom: 1px solid #dde1e7; padding: 10px 0; }
            summary { font-weight: 600; cursor: pointer; }
            .slot { display: inline-block; padding: 8px 12px; border: 1px solid #8a93a1; border-radius: 8px; margin: 4px 6px 4px 0; cursor: pointer; }
            h2 { margin-top: 32px; }
            .mark { display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: var(--accent); margin-right: 8px; }
        </style>
    </head>
    <body>
        <main>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
