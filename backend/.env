# In all environments, the following files are loaded if they exist, the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files. DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER
# COMMITTED FILES: on the server they go in .env.local (see README, "Deploying to cPanel").

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=4f0c1e9b7a2d63c85e1f09b4d7a6c2e1
###< symfony/framework-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=6d1c0f2a9e8b47d3a5f1c2e3b4a59687d0e1f2a3b4c5d6e7f8091a2b3c4d5e6f
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# On MariaDB (cPanel usually ships it) only serverVersion changes: serverVersion=10.11.2-MariaDB
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
# Mailpit (docker compose) catches all mail locally.
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

# Public base URL of the app, used in emailed links. docker-compose.yml sets it from HTTP_PORT.
APP_URL=http://localhost:8080
MAILER_FROM=no-reply@pontiac.local
# Encrypts the secrets consultants give us (Wompi's keys): 32 bytes in base64. This value is for local development
# only; production sets its own (php -r 'echo base64_encode(random_bytes(32));') and keeps it: changing it makes the
# stored secrets unreadable.
APP_ENCRYPTION_KEY=H3eKkLgDCEhrZyD2UIQ5gpFvtG5Ms7kEILO/AZpcqG0=

###> symfony/messenger ###
# A table in the app's own database (messenger_messages, created by the migrations), so a cPanel account needs no
# Redis or RabbitMQ. Drained by "messenger:consume async" (the worker service here, a cron line on the server).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
