# Production settings for a cPanel account. Copy to backend/.env.local, fill in, then: chmod 600 backend/.env.local
# It is never committed (backend/.gitignore ignores .env.local), so a git pull cannot overwrite it. The committed
# backend/.env holds the development values: every secret below MUST be set here to a new value.

APP_ENV=prod
APP_DEBUG=0

# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# The database cPanel created. The name and user carry the account prefix, and the host stays localhost.
# serverVersion MUST match the real server: run "mysql -V" (or SELECT VERSION() in phpMyAdmin) and copy it
# (MariaDB needs the suffix, e.g. 10.11.10-MariaDB). deploy/cpanel-update.sh refuses to continue until it matches.
DATABASE_URL="mysql://CPANELUSER_pontiac:PASSWORD@127.0.0.1:3306/CPANELUSER_pontiac?serverVersion=8.0.39&charset=utf8mb4"

# Another random 32-byte hex string. Changing it later needs a new key pair (delete backend/config/jwt/*.pem).
JWT_PASSPHRASE=

# Encrypts each consultant's Wompi secrets. 32 bytes in base64:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep it with your backups and never change it: the stored Wompi secrets cannot be read with another key.
APP_ENCRYPTION_KEY=

# The consultants' page images and their clients' files. OUTSIDE the document root (~/pontiac/backend/public):
# client files are only served to the people allowed to see them.
UPLOADS_DIR=/home/CPANELUSER/pontiac-uploads

# The public address, over HTTPS. It builds every link in the emails (booking, payment, portal, opt-out) and the
# Wompi events URL each consultant pastes in Wompi's dashboard.
APP_URL=https://pontiac.co
CORS_ALLOW_ORIGIN=^https://pontiac\.co$

# cPanel's own mail server (Exim). It offers STARTTLS with a certificate for the machine's hostname, so
# "localhost" fails with "Peer certificate CN=... did not match expected CN=localhost". Connect by the name on the
# certificate (it is in that error, or run: hostname -f) — the traffic still never leaves the machine:
MAILER_DSN=smtp://server-XXXXXX.example.com:587
# With a mailbox login, the "@" is %40:  smtp://no-reply%40pontiac.co:PASSWORD@server-XXXXXX.example.com:587
# A transactional provider instead, when the host's hourly limit is too low, e.g.:  smtp://USER:PASS@smtp-relay.brevo.com:587
# Test it from the super admin's Correos › "Enviar correo de prueba".
# It must be an address of that SMTP account (the sender name and Reply-To come from Configuración).
MAILER_FROM=no-reply@pontiac.co

# One server, so a file lock is enough.
LOCK_DSN=flock
